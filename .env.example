# =============================================================================
# 通用型表格解析引擎 — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# --- LLM Provider (OpenAI-compatible API) ---
# Required for production use. Leave empty to use mock mode for development.
LLM_API_KEY=sk-your-api-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.1
LLM_TIMEOUT=60

# --- Server ---
HOST=0.0.0.0
PORT=8000
DEBUG=false
# Comma-separated origins (use "*" for development)
CORS_ORIGINS=*

# --- Upload Limits ---
MAX_UPLOAD_SIZE_MB=20
# Allowed MIME types (comma-separated)
ALLOWED_IMAGE_TYPES=image/png,image/jpeg,image/webp,image/tiff

# --- Caching ---
CACHE_ENABLED=true
CACHE_MAX_ENTRIES=500
CACHE_TTL_SECONDS=3600

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=text

# --- Image Preprocessing ---
IMAGE_MAX_WIDTH=2048
IMAGE_MAX_HEIGHT=2048
IMAGE_QUALITY=85
